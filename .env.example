# Alpaca paper account dedicated to this options bot
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
ALPACA_PAPER=true

# Supabase project (shared with other Patrick projects; tables prefixed options_*)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Anthropic key for the Claude decision step
ANTHROPIC_API_KEY=your_anthropic_key_here

# Operational toggles
DRY_RUN=true                # true = log decisions but do not submit orders. Flip to false to go live.
DAILY_TRADE_CAP=1           # 1 entry/day pre-June-4-2026, then flip to 3 after PDT sunsets.
