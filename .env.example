# Alpaca paper account dedicated to this options bot
ALPACA_API_KEY=your_alpaca_key_here
ALPACA_SECRET_KEY=your_alpaca_secret_here
ALPACA_PAPER=true

# Supabase project (shared with other Patrick projects; tables prefixed options_*)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Anthropic key for the Claude decision step
ANTHROPIC_API_KEY=your_anthropic_key_here

# Operational toggles
DRY_RUN=false               # true = log decisions but do not submit orders. false = live paper trading.
DAILY_TRADE_CAP=10          # sanity throttle only; account is above $25K PDT threshold so PDT does not apply.
